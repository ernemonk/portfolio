rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: request is from the owner of this resource
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Users: each user owns their own profile doc
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    // Bio: stored per-user at bio/{userId}
    match /bio/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    // ─── Unified Work Items ───
    match /workItems/{docId} {
      allow read, list: if true;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
                             && resource.data.userId == request.auth.uid;
    }

    // ─── Legacy collections (kept for backwards compat) ───
    match /ventures/{docId} {
      allow read, list: if true;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
                             && resource.data.userId == request.auth.uid;
    }

    match /projects/{docId} {
      allow read, list: if true;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
                             && resource.data.userId == request.auth.uid;
    }

    match /experiments/{docId} {
      allow read, list: if true;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
                             && resource.data.userId == request.auth.uid;
    }

    // Messages: anyone can create (contact form), only the recipient can manage
    match /messages/{docId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null
                                   && resource.data.userId == request.auth.uid;
    }

    // Settings: per-user doc at settings/{userId}
    match /settings/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);
    }

    // Media / gallery: public read, owner write
    match /media/{docId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
                             && resource.data.userId == request.auth.uid;
    }
    match /gallery/{docId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
                             && resource.data.userId == request.auth.uid;
    }

    // Homepage structural sections: public read, owner write
    match /sections/{docId} {
      allow read, list: if true;
      allow write: if request.auth != null;
    }

    // Site metrics (homepage): public read, owner write
    match /siteMetrics/{docId} {
      allow read, list: if true;
      allow write: if request.auth != null;
    }

    // Legacy siteProjects (deprecated, use workItems)
    match /siteProjects/{docId} {
      allow read, list: if true;
      allow write: if request.auth != null;
    }
  }
}
