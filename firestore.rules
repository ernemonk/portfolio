rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // All portfolio collections: public read, authenticated write
    match /bio/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /ventures/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /projects/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /experiments/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /media/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /gallery/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
